# Copiar para .env.local. Valores locais: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Convites por email. Local: o Mailpit do Supabase (veja `supabase status`).
MAILPIT_URL=http://127.0.0.1:55324
# Produção (só na Vercel, nunca com NEXT_PUBLIC_): RESEND_API_KEY=

# Notificações push (Fase 3). A chave pública VAPID entra no build do cliente.
# Gerar o par: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# A privada NUNCA vai para a Vercel: só nos secrets do Supabase (ver docs/deploy.md):
# supabase secrets set CRON_SECRET VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY VAPID_SUBJECT RESEND_API_KEY APP_URL
# Em local, as mesmas variáveis (com MAILPIT_URL) ficam em supabase/functions/.env.

# Monitorização de erros (Sentry, região UE). Opcional: sem DSN fica desligado.
# O DSN é definido na Vercel (ver docs/deploy.md); nunca no repositório.
# SENTRY_DSN=                 (servidor)
# NEXT_PUBLIC_SENTRY_DSN=     (browser; entra no build)
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT: só para enviar sourcemaps no build da Vercel.
